{
  "name": "inkbloom",
  "version": "0.1.1",
  "description": "Inkbloom \u2014 a portrait sandbox of living inks that pile, flow, burn and bloom, and keep twenty secrets.",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "allowScripts": {
    "@firebase/util": false,
    "@series-inc/rundot-game-sdk@5.24.0": true,
    "esbuild@0.25.12": true,
    "fsevents": false,
    "protobufjs": false
  },
  "scripts": {
    "dev": "vite",
    "dev:playground": "cross-env RUNDOT_PLAYGROUND=1 vite",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint src scripts vite.config.js --diagnostic-level=error --max-diagnostics=none",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/check-game.mjs && node scripts/test-noise-random.mjs && node scripts/verify-sim.mjs",
    "simulate": "node scripts/verify-sim.mjs",
    "audit:public": "node scripts/audit-public.mjs",
    "build": "npm run typecheck && vite build && node scripts/check-build.mjs embedded",
    "build:bundled": "npm run typecheck && cross-env RUNDOT_GAME_DISABLE_EMBEDDED_LIBS=true vite build && node scripts/check-build.mjs bundled",
    "check": "npm run format:check && npm run lint && npm run test && npm run audit:public && npm run build && npm run build:bundled",
    "preview": "vite preview",
    "thumbnail": "node scripts/make-thumbnail.mjs",
    "visual-qa": "node scripts/visual-qa.mjs"
  },
  "dependencies": {
    "@series-inc/rundot-game-sdk": "5.24.0",
    "firebase": "12.16.0",
    "pixi.js": "^8.18.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@revenuecat/purchases-js": "^1.8.0",
    "@tailwindcss/vite": "^4.1.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "cross-env": "^7.0.3",
    "tailwindcss": "^4.1.5",
    "typescript": "^5.8.0",
    "vite": "^6.3.5",
    "playwright-core": "^1.62.0"
  }
}
